rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Uploaded media (cover images, inline article images, PDFs/files) is
    // publicly readable so it can be rendered/linked anywhere. Writes require
    // an authenticated session (anonymous counts) and a sane size cap.
    match /uploads/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 25 * 1024 * 1024;
    }

    // Deny everything else.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
